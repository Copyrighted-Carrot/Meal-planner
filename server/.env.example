# Local development only. Copy to .env and fill values privately.
# Never commit .env. Restart the server after changing configuration.
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/meal_planner_dev
JWT_SECRET=replace-with-a-long-random-secret

# Optional Google sign-in: must match the client OAuth configuration.
GOOGLE_CLIENT_ID=

# Image uploads require your own Cloudinary configuration.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional ingredient/nutrition providers. Blank means unconfigured.
# Some provider-assisted actions require a configured provider.
GEMINI_API_KEY=
GROQ_API_KEY=
USDA_API_KEY=

# Local Manager configuration; generate privately with setup_admin_env.js.
ADMIN_MASTER_PASSWORD=
ADMIN_JWT_SECRET=

# Legacy update_keys.js compatibility; no current application consumer.
OPENAI_API_KEY=
